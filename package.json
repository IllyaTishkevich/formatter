    "react-router-dom": "^7.15.1",
    "react-scripts": "5.0.1",
    "smol-toml": "^1.7.0",
    "web-vitals": "^2.1.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "postbuild": "react-snap",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "build:purge": "purgecss --config ./purgecss.config.js",
