      "/ini",
      "ini/properties",
      "ini/hcl",
      "properties/json",
      "properties/xml",
      "properties/yaml",
      "properties/csv",
      "properties/toml",
      "properties/tsv",
      "properties/ini",
      "/properties",
      "properties/hcl",
      "hcl/json",
      "hcl/xml",
      "hcl/yaml",
      "hcl/csv",
      "hcl/toml",
      "hcl/tsv",
      "hcl/ini",
