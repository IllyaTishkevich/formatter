      "xml/ini",
      "xml/properties",
      "xml/hcl",
      "yaml/json",
      "yaml/xml",
      "/yaml",
      "yaml/csv",
      "yaml/toml",
      "yaml/tsv",
      "yaml/ini",
      "yaml/properties",
      "yaml/hcl",
      "csv/json",
      "csv/xml",
      "csv/yaml",
      "/csv",
      "csv/toml",
      "csv/tsv",
      "csv/ini",
      "csv/properties",
      "csv/hcl",
      "toml/json",
