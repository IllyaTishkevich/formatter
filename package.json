{
  "name": "format",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://validformat.online",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@reduxjs/toolkit": "^2.12.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^13.2.1",
    "ajv": "^8.20.0",
    "bootstrap": "^5.3.8",
